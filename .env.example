# Market Dashboard environment template
# Copy to .env for local development. Leave optional keys blank to use built-in fallbacks.

# Server
PORT=3000
DATA_DIR=./data

# Admin key guarding action/mutation endpoints (report + AI-analysis generate,
# Telegram broadcast/test/diagnose, log import, and the detailed health probe).
# REQUIRED to enable those actions: while this is blank the server returns 503
# for them. In the browser, open a protected page (Reporter, AI Analysis,
# Settings) and enter this value when prompted — it is stored locally and sent
# as the x-admin-key header. Read-only views stay public.
ADMIN_API_KEY=

# Broadcast receipt ledger (/api/broadcast-ledger). Shared source of truth for
# every completed news broadcast, across the dashboard, the GPT/iOS Shortcut,
# the ShareBot67 OpenClaw agent and manual posting. Deliberately its own secret
# rather than reusing ADMIN_API_KEY: this key lives on a phone and in an agent
# config, and it should only be able to write receipts — not spend OpenAI
# credits or fire a broadcast. Falls back to ADMIN_API_KEY when blank; when
# both are blank the ledger endpoints return 503. Generate with:
#   openssl rand -hex 32
# See docs/broadcast-ledger.md. NOTE: DATA_DIR must point at the mounted
# Railway volume or the ledger will not survive a deploy.
BROADCAST_LEDGER_API_KEY=
# Requests per minute per client IP for the ledger endpoints. Default 60, 0 disables.
BROADCAST_LEDGER_RATE_LIMIT_PER_MIN=
# Auto-record broadcasts by watching the Telegram channels the bot already
# posts to. This is what makes the ledger automatic: every post becomes a
# receipt whoever sent it, so the shortcut needs no extra action, ShareBot67
# needs no change to be *recorded*, and nothing has to be typed by hand.
# Off unless set to exactly "true". Requires TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_IDS.
# Only one process may consume a bot's updates — if another service already
# polls this token (or a webhook is set) Telegram answers 409 and the watch
# logs once and stands down. Give the dashboard its own bot in that case.
BROADCAST_LEDGER_INGEST_ENABLED=
# How often to poll for new channel posts. Default 60000ms, floor 15000ms.
BROADCAST_LEDGER_INGEST_INTERVAL_MS=
# Optional comma-separated Telegram destinations watched by the ledger. Use
# the same chatId or chatId:threadId format as TELEGRAM_CHAT_IDS. When omitted,
# the watchlist defaults to the exact broadcast destinations. A topic target
# watches only that topic, never General or another topic in the supergroup.
BROADCAST_LEDGER_TELEGRAM_WATCHLIST=
# Private chat/topic targets for blocked, failed, and missing-category alerts.
BROADCAST_LEDGER_NOTIFICATION_CHAT_IDS=

# Website login. When set, the dashboard redirects unauthenticated visitors to
# /login. This owner password unlocks the full website. It does not replace
# ADMIN_API_KEY; protected actions still require the admin key.
MARKET_DASHBOARD_LOGIN_PASSWORD=

# OpenAI reporter endpoint (/reporter.html and /api/daily-report)
OPENAI_API_KEY=
REPORTER_MODEL=gpt-5.4-mini

# Newsroom cycles (/api/newsroom). A cycle is one complete scheduled reporting
# run: preflight, generation, delivery. See docs/newsroom-cycles.md.
#
# Sections one cycle is expected to produce. Empty means the reporter's own
# default set (crypto, economics, markets).
NEWSROOM_SECTIONS=
# Optional "HH:MM,HH:MM" in UTC. Used only to report the next expected run in
# /api/newsroom/health — the schedule itself lives in the external cron, so a
# wrong value here misreports a time, it cannot cause or skip a run.
NEWSROOM_EXPECTED_RUN_TIMES_UTC=
# How many cycles to retain (default 200). Cycles hold no report text — that
# stays in the reporter generation log — so history is cheap.
NEWSROOM_CYCLE_HISTORY=200

# Telegram reporter delivery (also used by the AI Analysis broadcast button)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids. To target a specific forum "topic" thread inside a
# group instead of its general chat, append :threadId, e.g.:
# TELEGRAM_CHAT_IDS=-1001841650798:6297,-1001941064823:984
#
# Stock, Crypto, and Economics news sent through /api/broadcast-ledger/broadcast
# is restricted in code to only:
# -1001841650798:6297 and -1001941064823:984. Keep those targets configured.
# Geopolitics and other categories continue to use the general list here.
TELEGRAM_CHAT_IDS=
# Dedicated ShareClaw97 sender for every Broadcast Ledger / Shortcut news
# delivery. The news route never falls back to TELEGRAM_BOT_TOKEN.
NEWS_TELEGRAM_BOT_TOKEN=
NEWS_TELEGRAM_CHAT_IDS=-1001841650798:6297,-1001941064823:984
# Public Market Dashboard URL used in group alerts. When blank, alerts omit
# dashboard links rather than sending local-only or guessed URLs.
MARKET_DASHBOARD_URL=
# Optional read-only access code for Alpha Team shared links (`?view=alpha`).
# When set, this password only unlocks the shared Alpha review pages and their
# read-only APIs. Leave blank for local/dev open review mode.
ALPHA_TEAM_ACCESS_CODE=

# Signal Bot — the background loop that re-scans the Signal Screener and
# Pattern Scanner and alerts on state *changes* (FLAT -> LONG, a pattern
# reaching breakout). Runs whenever Telegram is configured above.
SIGNAL_BOT_ENABLED=true
SIGNAL_BOT_INTERVAL_MS=900000
# Comma-separated; defaults to 4h,1D when blank.
SIGNAL_BOT_TIMEFRAMES=
SIGNAL_BOT_MIN_CHECKS=4

# Signal Bot -> Trading Lab bridge. This is the replacement for TradingView
# alert webhooks: the bot already detects FLAT -> LONG/SHORT on closed candles
# without a TradingView subscription.
#
# Default is a DRY RUN: every entry transition is scored through the full
# checklist -> edge gate -> risk sizing pipeline and logged, but nothing is
# opened. Set to exactly "true" to let it open PAPER positions (never live —
# live execution stays behind TRADING_MODE=live plus ALLOW_LIVE_TRADING=true,
# which this bridge does not touch).
SIGNAL_BOT_PAPER_TRADE_ENABLED=false
# Which Trading Lab book bridged trades land in: main | shadow | alts.
SIGNAL_BOT_BOOK=main
# Mark open paper positions to market on every bot interval, so stops and
# take-profits fire without the Trading Lab page open. Set "false" to opt out.
SIGNAL_BOT_AUTO_MARK_ENABLED=true

# Live Scanner (/api/live-scanner/status) — a native scanner that pulls its own
# Bitget USDT-perpetual candles and runs its own strategy on a fast loop, so BTC
# signals are generated here rather than arriving from a TradingView webhook.
# It evaluates fully closed candles only, opens at most one position per symbol,
# and de-dupes on symbol + direction + candle close time (persisted, so a
# redeploy mid-bar cannot re-enter a candle already traded).
#
# PAPER ONLY. No exchange-order code is reachable from the scanner.
#
# Off unless set to exactly "true".
ENABLE_LIVE_SCANNER=false
# TradingView-style ".P" perpetual notation. Maps to Bitget's BTCUSDT contract
# on USDT-FUTURES while keeping the ".P" name in the paper ledger, so scanner
# trades are never confused with the Signal Bot's spot pairs.
LIVE_SCANNER_SYMBOL=BTCUSDT.P
# 1m | 3m | 5m | 15m | 30m | 1h | 4h | 6h | 12h | 1d
LIVE_SCANNER_TIMEFRAME=15m
LIVE_SCANNER_STRATEGY=mindset_v1
# Backtest execution cost model. Rates are decimal fractions: 0.0006 = 0.06%.
# v1 models all fills as taker fills, which is conservative for market entries.
BACKTEST_TAKER_FEE_RATE=0.0006
BACKTEST_SLIPPAGE_RATE=0.0002
BACKTEST_FUNDING_RATE_8H=0
# Poll cadence. 60s on a 15m timeframe means a closed bar is acted on within a
# minute rather than up to a full bar later.
LIVE_SCANNER_INTERVAL_MS=60000
# Higher-timeframe context feeding the checklist's regime and daily-bias
# buckets. A 15m bar has no opinion on the daily trend.
LIVE_SCANNER_CONTEXT_INTERVAL=4h
# Which Trading Lab book scanner trades land in: main | shadow | alts.
LIVE_SCANNER_BOOK=main
# Paper positions are the point of enabling the scanner, so this defaults on
# once ENABLE_LIVE_SCANNER=true. Set "false" for an observe-only run that still
# scores and logs every signal but opens nothing.
LIVE_SCANNER_PAPER_TRADE_ENABLED=true

# Live demo research accounts. Enabled by default and PAPER ONLY. All
# candle-compatible strategies evaluate the same closed BTCUSDT 1h candles in
# isolated ledgers. This does not change lifecycle/scanner eligibility.
# Startup refuses a paper-trading Live Scanner and Live Research claiming the
# same strategy account. Disable one writer instead of mixing experiments.
LIVE_RESEARCH_ENABLED=true
LIVE_RESEARCH_SYMBOL=BTCUSDT
LIVE_RESEARCH_TIMEFRAME=1h
LIVE_RESEARCH_INTERVAL_MS=60000

# AI Analysis (/ai-analysis.html and /api/ai-analysis) — renders a TradingView
# chart via chart-img.com, then sends it to an OpenAI vision model for a
# BUY/SELL/HOLD read. Reuses OPENAI_API_KEY above.
CHART_IMG_API_KEY=
CHART_IMG_BASE_URL=https://api.chart-img.com/v2/tradingview/advanced-chart/storage
AI_ANALYSIS_MODEL=gpt-5.4-mini
AI_ANALYSIS_CACHE_MS=1800000
# Optional JSON array to override the default crypto + BTC-correlated macro 4h presets, e.g.:
# AI_ANALYSIS_SYMBOLS=[{"symbol":"BINANCE:BTCUSDT","label":"BTCUSDT","interval":"4h"}]
AI_ANALYSIS_SYMBOLS=

# Overview API (/api/overview)
OVERVIEW_CACHE_MS=60000
MARKET_DATA_PROVIDER=coingecko
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.coingecko.com/api/v3
MARKET_DATA_TIMEOUT_MS=8000
MARKET_DATA_RETRIES=1

# CoinGecko keys are optional. Anonymous public data is used when blank.
COINGECKO_DEMO_API_KEY=
COINGECKO_API_KEY=
COINGECKO_KEY_HEADER=

# Live equities through Finnhub. Without this, equities fall back to static values.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# X Intelligence (/x-intelligence.html). Uses the official X API when set,
# otherwise falls back to the public syndication endpoint. X API access is
# pay-per-use against prepaid credits; the app must be attached to a Project.
#
# A rejected token (401), an app-level denial (403 client-forbidden / app not
# enrolled) or a usage cap (429) opens a 15-minute circuit that skips every
# further official call, so one bad credential cannot turn into a request per
# account. A 403 for a single protected or suspended account, and a 404, fail
# only that account — one private handle does not take the feed down. After
# repairing the credential, either wait out the cooldown or clear it:
#   POST /api/x/diagnostics/reset-circuits   (header: x-admin-key)
#
# GET /api/x/diagnostics (same header) reports provider health and where the
# last-known-good cache lives. On Railway, check `cache.storageSource`: it
# reads `railway-volume`, `data-dir`, or `default`. `default` means no volume
# path was configured at all, so the cache sits on container-local disk and is
# lost on every deploy, stripping the feed of its offline fallback. Note that
# `railway-volume` says only that RAILWAY_VOLUME_MOUNT_PATH was set — that a
# volume is genuinely mounted there is still a manual check against Railway.
X_API_BEARER_TOKEN=

# ── YouTube Intelligence (/youtube-v2.html and /api/youtube) ─────────────────
# YouTube Data API v3 key. Server-side only: it is never sent to the browser
# and is redacted out of every log line. Create it in Google Cloud Console
# (enable "YouTube Data API v3" -> Credentials -> API key), and restrict it to
# that one API.
#
# With a key:    uploads + live / upcoming stream detection.
# Without a key: uploads only, over RSS, for channels whose UC... ID is known.
YOUTUBE_API_KEY=
# Optional handle -> channel ID overrides. Either JSON or the terser
# "handle=UC...,handle=UC..." form. Setting these removes one API call per
# handle and is what lets the keyless RSS fallback work on a fresh deploy.
# Print them with: YOUTUBE_API_KEY=... node scripts/resolve-youtube-channels.js
# YOUTUBE_CHANNEL_IDS=stockmoe=UCxxxxxxxxxxxxxxxxxxxxxx,cryptosrus=UCyyyyyyyyyyyyyyyyyyyyyy
YOUTUBE_CHANNEL_IDS=
YOUTUBE_MAX_VIDEOS_PER_CHANNEL=8
YOUTUBE_REQUEST_TIMEOUT_MS=10000
# Server-side cache TTLs. These are what keep a refreshing dashboard off the
# API: roughly 5 quota units per refresh cycle for four channels, against a
# 10,000/day default quota.
YOUTUBE_CHANNEL_ID_CACHE_MS=2592000000
YOUTUBE_CHANNEL_META_CACHE_MS=86400000
YOUTUBE_UPLOADS_CACHE_MS=600000
YOUTUBE_LIVE_CACHE_MS=120000
# How long to stop calling the API after it reports the daily quota is gone,
# so an exhausted key isn't re-hit on every refresh.
YOUTUBE_QUOTA_COOLDOWN_MS=1800000
# Opt-in live discovery through search.list. Off by default and best left off:
# search.list costs 100 units per call, so four channels polled every 30
# minutes is ~19,000 units/day — nearly twice the free daily quota on its own.
# The uploads-playlist path already surfaces live and scheduled streams.
YOUTUBE_LIVE_SEARCH_ENABLED=false
YOUTUBE_LIVE_SEARCH_CACHE_MS=1800000

# Optional JSON news feed URL. Without this, news falls back to static headlines.
MARKET_NEWS_URL=

# Macro/FX board (DXY, VIX, gold, oil). Priority order:
#   1. MACRO_DATA_URL — a JSON feed (array or {items:[...]}) of
#      {symbol, name, price, changePercent} rows.
#   2. FINNHUB_API_KEY — quotes the MACRO_SYMBOLS instruments below.
#   3. Neither — static fallback values (flagged in dataQuality).
# Set MACRO_DATA_PROVIDER=none to force fallback even when a key is present.
MACRO_DATA_PROVIDER=
MACRO_DATA_URL=
# Comma-separated DISPLAY=PROVIDER_SYMBOL pairs for the Finnhub adapter.
# Defaults to free-tier ETF proxies: XAU=GLD,DXY=UUP,WTI=USO,VIX=VIXY.
# Paid Finnhub plans can map real instruments, e.g.:
# MACRO_SYMBOLS=DXY=UUP,VIX=VIXY,XAU=OANDA:XAU_USD,WTI=OANDA:WTICO_USD
# Adding a US10Y row (via MACRO_SYMBOLS or MACRO_DATA_URL) also feeds the
# Decision Engine's regime score and rotation board bond/yield reads.
MACRO_SYMBOLS=

# Decision Engine (/decision.html and /api/decision) — regime score, rotation
# board, setup-quality ranking and execution levels built from the feeds above
# plus the signal screener. Payload cache TTL:
DECISION_CACHE_MS=120000

# ── Trading Lab ──────────────────────────────────────────────────────────────
# Paper execution, risk sizing and the historical edge gate, ported from the
# retired TraderClaw deployment. Variable names still match its originals, so
# settings carried over from it keep working. Every value below is optional —
# the defaults shown are what the Lab uses when nothing is set.
#
# Live execution is NOT implemented here, and TRADING_MODE=live requires
# ALLOW_LIVE_TRADING=true as a second gate so one mistaken variable can never
# put the app in an ambiguous live/paper state.
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false

# Risk. MAX_RISK_PER_TRADE and MAX_TOTAL_RISK are fractions, not percents.
ACCOUNT_SIZE=10000
MAX_RISK_PER_TRADE=0.01
MAX_TOTAL_RISK=0.04
MAX_OPEN_POSITIONS=3

# Stop/target geometry. ATR_FALLBACK_PCT is used only when a signal carries no
# ATR — one value for every code path, so paper results stay comparable.
ATR_FALLBACK_PCT=0.01
SL_ATR_MULTIPLE=1.5
TP1_R_MULTIPLE=1.5
TP2_R_MULTIPLE=2.5

# Trade management: TP1 scales out of half the position and moves the stop to
# breakeven on the remainder.
TP1_CLOSE_FRACTION=0.5
MOVE_STOP_TO_BREAKEVEN_AT_TP1=true

# Kill switches — checked before a setup can earn any score.
DAILY_LOSS_LIMIT_PCT=3
WEEKLY_LOSS_LIMIT_PCT=6
MAX_CONSECUTIVE_LOSSES=3
MAX_ATR_RATIO=3
FUNDING_KILL_ABS=0.001
FUNDING_NEUTRAL_ABS=0.0005

# Points awarded when entry-trigger indicators are absent. Missing data is not
# evidence for a trade, so this defaults to zero.
MISSING_INDICATOR_POINTS=0

# Historical edge gate. Below EDGE_MIN_SAMPLE_TRADES closed trades everything
# is allowed through as a learning trade; past it, weak expectancy, a poor
# profit factor or deep drawdown reduce size or block the entry.
EDGE_MIN_SAMPLE_TRADES=20
EDGE_MIN_EXPECTANCY_R=0.05
EDGE_MIN_PROFIT_FACTOR=1.10
EDGE_MAX_DRAWDOWN_PCT=15
EDGE_SOFT_DRAWDOWN_PCT=10
EDGE_SOFT_EXPECTANCY_R=0.15

# Optional JSON macro-calendar feed URL (array or {events:[...]}) of
# {time|datetime, title|event, impact|importance, country} rows. Without this,
# the calendar tab falls back to static seed events and news risk is scored off
# seed data rather than real releases.
#
# Prefer a feed that emits ISO timestamps with an offset ("2026-08-23T08:30:00-04:00"
# or "...Z"): those need no assumption. Bare clock labels ("08:30") carry no
# zone, so they are read in MACRO_CALENDAR_TIMEZONE below.
MACRO_CALENDAR_URL=

# The zone MACRO_CALENDAR_URL publishes bare clock labels in, e.g.
# America/New_York for a US macro feed. Defaults to UTC. Ignored for events that
# state their own offset, and for values carrying a recognised suffix ("08:30 ET").
# Getting this wrong shifts the entire high-impact window by the offset, so
# check dataQuality.calendar.timing in /api/decision after setting it.
MACRO_CALENDAR_TIMEZONE=

# DefiLlama on-chain / stablecoin data
DEFILLAMA_API_BASE_URL=https://stablecoins.llama.fi/
DEFILLAMA_COINS_API_BASE_URL=https://coins.llama.fi/
DEFILLAMA_CHAIN=Ethereum
DEFILLAMA_COIN_CHAIN=ethereum

# Etherscan wallet detail API
ETHERSCAN_API_KEY=
ETHERSCAN_KEY=
ETHERSCAN_API_BASE_URL=https://api.etherscan.io
ETHERSCAN_CHAIN_ID=1
ETHERSCAN_API_REQUEST_TIMEOUT_MS=15000
ETHERSCAN_API_RETRIES=2

# Covalent transfer analytics API
COVALENT_API_KEY=
COVALENT_KEY=
COVALENT_API_BASE_URL=https://api.covalenthq.com
COVALENT_CHAIN_NAME=eth-mainnet
COVALENT_API_REQUEST_TIMEOUT_MS=15000
COVALENT_API_RETRIES=2
COVALENT_CREDIT_COOLDOWN_MS=1800000
COVALENT_RATELIMIT_COOLDOWN_MS=120000

# On-chain analytics tuning
# ONCHAIN_MODE picks Covalent credit-spend defaults: cheap (default; 1 page of
# 50 rows over 6h, 5-min cache), normal (previous defaults), deep (4 pages for
# manual deep dives). Any ONCHAIN_* var below overrides its preset value.
ONCHAIN_MODE=cheap
# How long to keep serving the cached overview while Covalent is cooling down
# after a 402/429, instead of rebuilding the degraded payload every refresh.
ONCHAIN_COOLDOWN_CACHE_MS=600000
ONCHAIN_TRACKED_TOKENS=[{"symbol":"USDC","name":"USD Coin","contractAddress":"0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48","decimals":6},{"symbol":"USDT","name":"Tether USD","contractAddress":"0xdac17f958d2ee523a2206206994597c13d831ec7","decimals":6}]
ONCHAIN_IGNORED_ADDRESSES=
ONCHAIN_OVERVIEW_CACHE_MS=180000
ONCHAIN_DETAIL_CACHE_MS=60000
ONCHAIN_OVERVIEW_LOOKBACK_HOURS=24
ONCHAIN_DETAIL_LOOKBACK_DAYS=7
ONCHAIN_OVERVIEW_PAGE_SIZE=100
ONCHAIN_DETAIL_PAGE_SIZE=100
ONCHAIN_OVERVIEW_PAGE_LIMIT=2
ONCHAIN_TOKEN_PAGE_LIMIT=2
ONCHAIN_MAX_LARGE_TRANSFERS=25
ONCHAIN_MAX_WALLET_ROWS=10
ONCHAIN_MAX_TOKEN_ROWS=10
ONCHAIN_MAX_DETAIL_TRANSFERS=25
ONCHAIN_LARGE_TRANSFER_THRESHOLD_USD=100000
ONCHAIN_WHALE_THRESHOLD_USD=100000
