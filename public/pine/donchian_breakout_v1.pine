//@version=5
strategy("Market Dashboard - Donchian Breakout v1", overlay=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.06, slippage=2)
channelLength = input.int(20, "Channel length", minval=2)
atrLen = input.int(14, "ATR length", minval=2)
stopAtr = input.float(2.0, "Stop ATR", minval=0.1)
rewardR = input.float(3.0, "Reward R", minval=0.1)
trendLength = input.int(100, "Trend SMA", minval=2)
useTrend = input.bool(true, "Use trend filter")
channelHigh = ta.highest(high[1], channelLength)
channelLow = ta.lowest(low[1], channelLength)
priorHigh = ta.highest(high[2], channelLength)
priorLow = ta.lowest(low[2], channelLength)
trend = ta.sma(close, trendLength)
a = ta.atr(atrLen)
freshLong = close > channelHigh and not (close[1] > priorHigh)
freshShort = close < channelLow and not (close[1] < priorLow)
longSignal = freshLong and (not useTrend or close > trend)
shortSignal = freshShort and (not useTrend or close < trend)
if longSignal
    strategy.entry("Long", strategy.long)
if shortSignal
    strategy.entry("Short", strategy.short)
strategy.exit("Long exit", "Long", stop=strategy.position_avg_price-stopAtr*a, limit=strategy.position_avg_price+stopAtr*rewardR*a)
strategy.exit("Short exit", "Short", stop=strategy.position_avg_price+stopAtr*a, limit=strategy.position_avg_price-stopAtr*rewardR*a)
plot(channelHigh, "Prior high", color=color.new(color.green, 30))
plot(channelLow, "Prior low", color=color.new(color.red, 30))
plot(useTrend ? trend : na, "Trend SMA", color=color.orange)
